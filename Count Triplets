// Complete the countTriplets function below.
#define HASH_SIZE 200003 // A prime number larger than the max array size

typedef struct {
    long key;
    long val;
    bool occupied;
} HashEntry;

// Simple hash function for long keys
int get_hash(long key) {
    unsigned long h = (unsigned long)key;
    h ^= (h >> 33);
    h *= 0xff51afd7ed558ccdULL;
    h ^= (h >> 33);
    h *= 0xc4ceb9fe1a85ec53ULL;
    h ^= (h >> 33);
    return h % HASH_SIZE;
}

// Find or insert a key in the open-addressed hash map
HashEntry* hash_get(HashEntry* table, long key) {
    int idx = get_hash(key);
    while (table[idx].occupied) {
        if (table[idx].key == key) {
            return &table[idx];
        }
        idx = (idx + 1) % HASH_SIZE;
    }
    table[idx].key = key;
    table[idx].val = 0;
    table[idx].occupied = true;
    return &table[idx];
}

long countTriplets(int arr_count, long* arr, long r) {
    // Allocate hash maps on heap to prevent stack overflow
    HashEntry* map_singles = calloc(HASH_SIZE, sizeof(HashEntry));
    HashEntry* map_pairs = calloc(HASH_SIZE, sizeof(HashEntry));
    long total_triplets = 0;

    for (int i = 0; i < arr_count; i++) {
        long v = arr[i];

        // 1. If v is divisible by r, it can complete triplets with existing pairs (v/r, v)
        if (v % r == 0) {
            long prev = v / r;
            int idx = get_hash(prev);
            while (map_pairs[idx].occupied) {
                if (map_pairs[idx].key == prev) {
                    total_triplets += map_pairs[idx].val;
                    break;
                }
                idx = (idx + 1) % HASH_SIZE;
            }
        }

        // 2. If v is divisible by r, it forms new pairs with existing single elements (v/r)
        if (v % r == 0) {
            long prev = v / r;
            int idx = get_hash(prev);
            long singles_count = 0;
            while (map_singles[idx].occupied) {
                if (map_singles[idx].key == prev) {
                    singles_count = map_singles[idx].val;
                    break;
                }
                idx = (idx + 1) % HASH_SIZE;
            }
            if (singles_count > 0) {
                HashEntry* pair_entry = hash_get(map_pairs, v);
                pair_entry->val += singles_count;
            }
        }

        // 3. Register the current value as a single element for future elements
        HashEntry* single_entry = hash_get(map_singles, v);
        single_entry->val++;
    }

    // Clean up memory
    free(map_singles);
    free(map_pairs);

    return total_triplets;
}

